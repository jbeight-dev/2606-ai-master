# LLM Provider: gemini | openai
LLM_PROVIDER=gemini

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI (leave OPENAI_BASE_URL/OPENAI_API_VERSION empty to use the default OpenAI API;
# set both to point at an Azure OpenAI or compatible gateway)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
OPENAI_API_VERSION=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wiki_builder

# Qdrant
QDRANT_URL=http://localhost:6333

QDRANT_COLLECTION_NAME=wiki_embeddings

# App
STORAGE_PATH=app/storage/uploads
PORT=8000
LOG_LEVEL=INFO
